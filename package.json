{
  "name": "lizhi-334-player",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "李志 · 叁叁肆 个人音乐播放器（前端优先，数据写死）",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win --dir",
    "desktop:dist": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.sqy.lizhi334",
    "productName": "叁叁肆",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Lizhi334-${version}-portable.${ext}",
      "icon": "electron/assets/icon-256.png"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
